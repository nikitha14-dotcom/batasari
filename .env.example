# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# Model providers - server-side only, never expose to client
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Reserved for a Gemini fallback model. Nothing reads it today. This is NOT
# the geocoding key -- that one is GOOGLE_MAPS_API_KEY, further down.
GOOGLE_API_KEY=

# Geocoding for /crime/stats/by-address, which powers /housing/check. Only
# needed to run the API on your own machine; staging and production read it
# from Secret Manager. Without it every address lookup returns 404 and the
# page cannot tell that apart from "not a Toronto address".
#
# You can skip this entirely by pointing NEXT_PUBLIC_API_URL at the deployed
# staging API instead of running the API locally -- but then set
# NEXT_PUBLIC_SUPABASE_URL to the matching staging project too. The API
# verifies bearer tokens against its own Supabase, so a dev token sent to the
# staging API is rejected and the AI Co-Pilot stops working.
GOOGLE_MAPS_API_KEY=

# Fallback model, used when the primary model call fails. Leave the key blank
# to turn the fallback off. Any OpenAI-compatible endpoint works; the key is
# the DeepInfra one in Secret Manager (secret name: DeepInfra).
FALLBACK_API_KEY=
FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash
FALLBACK_BASE_URL=https://api.deepinfra.com/v1/openai

# Tracing to Arize AX. Leave blank to turn it off (nothing is sent). Question,
# answer and profile text are always hidden from traces. Staging reads these
# from Secret Manager (ARIZE_API_KEY, ARIZE_SPACE_ID).
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# App
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# Which registered prompt /ai/answer uses (api/app/gateway/prompts.py). Blank
# means the default. Changing it on Cloud Run is the rollback path -- ADR 0012.
PROMPT_VERSION=

# Opt in only after ADR 0014 is approved. Generic answers are cached only when
# no profile, preference, user-specific retrieval, or apparent PII is present.
GENERIC_ANSWER_CACHE_ENABLED=false

# Three-day Beta access. Leave disabled until the team exemption setting has
# been applied and verified. Set EPOCH to the same UTC instant the flag is
# enabled; existing users receive a fresh window from this floor.
BETA_ACCESS_ENABLED=false
BETA_ACCESS_DAYS=3
BETA_ACCESS_EPOCH=
BETA_RETENTION_DAYS=7
# Keep false for the initial staging preview. The hourly job reports due rows
# without deleting until this is explicitly enabled after review.
BETA_RETENTION_DELETE_ENABLED=false
# Set only when the entire Beta is stopped. At this instant the application
# closes for everyone and retention uses the earlier of this timestamp and
# each user's ordinary access end. Removing it reopens time-exempt access and
# clears the synchronized database stop timestamp on the next API startup.
BETA_STOPPED_AT=

# All-time model spend allowed per non-exempt user.
AI_SPEND_CAP_USD=1.00
# Comma-separated Supabase user IDs. The same list bypasses both the $1 AI
# spend cap and the 72-hour Beta expiry; the daily request limit still applies.
AI_SPEND_CAP_EXEMPT_USER_IDS=

# Where the browser reaches the API. Must be NEXT_PUBLIC_* to be readable from
# client code; API_BASE_URL above is the server-side name for the same thing.
NEXT_PUBLIC_API_URL=

# Origin used to build the magic-link redirect (<site>/auth/callback). Leave
# blank locally and the browser's own origin is used. Set it in Vercel so links
# in emails point at the deployed site instead of localhost.
NEXT_PUBLIC_SITE_URL=

# Comma-separated origins the API accepts browser requests from.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional. Regex for origins that change per deployment -- Vercel gives every
# preview build a new hostname, so they cannot be listed above. Anchor it, or a
# bare "vercel.app" would match any site on that domain. Leave blank locally.
# Deployed value:
#   ^https://moving-assistant-[a-z0-9-]+-jiagu12345s-projects\.vercel\.app$
CORS_ALLOW_ORIGIN_REGEX=

# Local convenience only. When set, the browser sends x-test-user-id and the
# API honours it -- but ONLY when ENVIRONMENT=development. Leave blank unless
# you are deliberately bypassing sign-in on your own machine.
NEXT_PUBLIC_TEST_USER_ID=

